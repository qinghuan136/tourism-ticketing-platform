{
  "openapi": "3.0.3",
  "info": {
    "title": "电子票查询接口",
    "description": "游客分页查询本人电子票并查看票券详情。",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "TouristTicket",
      "description": "游客端电子票查询"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tourist/tickets": {
      "get": {
        "tags": [
          "TouristTicket"
        ],
        "summary": "分页查询我的票券",
        "description": "分页查询当前游客订单生成的电子票，可按票券状态筛选。",
        "operationId": "pageMyTickets",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Size"
          },
          {
            "$ref": "#/components/parameters/TicketStatusQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPageApiResponse"
                },
                "example": {
                  "code": "SUCCESS",
                  "message": "操作成功",
                  "data": {
                    "items": [
                      {
                        "id": 701,
                        "ticketCode": "TK-A8F29X2",
                        "status": "VALID",
                        "venueName": "海湾科技馆",
                        "visitDate": "2026-08-03",
                        "startTime": "09:00:00",
                        "endTime": "11:00:00",
                        "visitorName": "张三",
                        "ticketTypeName": "成人票",
                        "validFrom": "2026-08-03T09:00:00",
                        "validUntil": "2026-08-03T11:00:00"
                      }
                    ],
                    "total": 1,
                    "page": 1,
                    "size": 20
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/tourist/tickets/{ticketId}": {
      "get": {
        "tags": [
          "TouristTicket"
        ],
        "summary": "获取我的票券详情",
        "description": "获取当前游客本人票券的完整展示信息。票券不存在或不属于当前游客时统一返回不存在。",
        "operationId": "getMyTicket",
        "parameters": [
          {
            "$ref": "#/components/parameters/TicketId"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetailApiResponse"
                },
                "example": {
                  "code": "SUCCESS",
                  "message": "操作成功",
                  "data": {
                    "id": 701,
                    "ticketCode": "TK-A8F29X2",
                    "status": "USED",
                    "orderId": 501,
                    "orderNo": "202608010001",
                    "venueId": 10,
                    "venueName": "海湾科技馆",
                    "venueAddress": "广州市番禺区海湾大道 88 号",
                    "visitorId": 101,
                    "visitorName": "张三",
                    "ticketTypeName": "成人票",
                    "visitDate": "2026-08-03",
                    "startTime": "09:00:00",
                    "endTime": "11:00:00",
                    "validFrom": "2026-08-03T09:00:00",
                    "validUntil": "2026-08-03T11:00:00",
                    "verifiedAt": "2026-08-03T09:15:20"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/TicketNotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "页码，从 1 开始",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Size": {
        "name": "size",
        "in": "query",
        "required": false,
        "description": "每页数量",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "TicketStatusQuery": {
        "name": "status",
        "in": "query",
        "required": false,
        "description": "票券状态",
        "schema": {
          "$ref": "#/components/schemas/TicketStatus"
        }
      },
      "TicketId": {
        "name": "ticketId",
        "in": "path",
        "required": true,
        "description": "票券 ID",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "TicketStatus": {
        "type": "string",
        "enum": [
          "VALID",
          "REFUNDING",
          "USED",
          "VOID",
          "EXPIRED"
        ]
      },
      "TicketListItem": {
        "type": "object",
        "required": [
          "id",
          "ticketCode",
          "status",
          "venueName",
          "visitDate",
          "startTime",
          "endTime",
          "visitorName",
          "ticketTypeName",
          "validFrom",
          "validUntil"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "ticketCode": {
            "type": "string",
            "maxLength": 64,
            "description": "核销使用的唯一票码"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "venueName": {
            "type": "string"
          },
          "visitDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
            "format": "time"
          },
          "visitorName": {
            "type": "string"
          },
          "ticketTypeName": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TicketDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TicketListItem"
          },
          {
            "type": "object",
            "required": [
              "orderId",
              "orderNo",
              "venueId",
              "venueAddress",
              "visitorId"
            ],
            "properties": {
              "orderId": {
                "type": "integer",
                "format": "int64"
              },
              "orderNo": {
                "type": "string"
              },
              "venueId": {
                "type": "integer",
                "format": "int64"
              },
              "venueAddress": {
                "type": "string"
              },
              "visitorId": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ]
      },
      "TicketPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketListItem"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "SUCCESS"
          },
          "message": {
            "type": "string",
            "example": "操作成功"
          }
        }
      },
      "TicketPageApiResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/TicketPage"
              }
            }
          }
        ]
      },
      "TicketDetailApiResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/TicketDetail"
              }
            }
          }
        ]
      },
      "ErrorApiResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "票券不存在"
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "分页、状态或票券 ID 参数不合法",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorApiResponse"
            },
            "example": {
              "code": "INVALID_REQUEST",
              "message": "请求参数不合法"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或 JWT 已失效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorApiResponse"
            },
            "example": {
              "code": "UNAUTHORIZED",
              "message": "请先登录"
            }
          }
        }
      },
      "Forbidden": {
        "description": "当前账号不是游客",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorApiResponse"
            },
            "example": {
              "code": "FORBIDDEN",
              "message": "无权执行该操作"
            }
          }
        }
      },
      "TicketNotFound": {
        "description": "票券不存在或不属于当前游客",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorApiResponse"
            },
            "example": {
              "code": "NOT_FOUND",
              "message": "票券不存在"
            }
          }
        }
      }
    }
  }
}
